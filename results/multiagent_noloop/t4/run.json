  "findings": [
    {
      "id": "F001",
      "claim": "Allegretto, Dube, and Reich argue that traditional canonical models for estimating minimum wage employment effects are biased by failing to account for pre-existing regional trends in low-skill labor markets.",
      "source_url": "https://irle.berkeley.edu/wp-content/uploads/2011/08/Do-Minimum-Wages-Really-Reduce-Teen-Employment.pdf",
      "confidence": "high"
    },
    {
      "id": "F002",
      "claim": "Allegretto, Dube, and Reich advocate for using contiguous border county pairs as close controls to account for shocks correlated with minimum wage changes.",
      "source_url": "https://irle.berkeley.edu/wp-content/uploads/2011/08/Do-Minimum-Wages-Really-Reduce-Teen-Employment.pdf",
      "confidence": "high"
    },
    {
      "id": "F003",
      "claim": "Neumark, Salas, and Wascher argue that the use of close controls and the treatment of trends in state-level panel data by Allegretto, Dube, and Reich do not generate reliable evidence.",
      "source_url": "https://sites.socsci.uci.edu/~dneumark/MW%20US%20literature.05.pdf",
      "confidence": "high"
    },
    {
      "id": "F004",
      "claim": "Allegretto, Dube, and Reich reported an own-wage elasticity for teen employment of 0.315 in 2011.",
      "source_url": "https://ideas.repec.org/a/bla/indres/v50y2011i2p205-240.html",
      "confidence": "high"
    },
    {
      "id": "F005",
      "claim": "Allegretto, Dube, Reich, and Zipperer reported an own-wage elasticity for teen employment of 0.043 in 2017.",
      "source_url": "https://whatweknow.inequality.cornell.edu/topics/does-raising-the-minimum-wage-negatively-impact-employment",
      "confidence": "high"
    },
    {
      "id": "F006",
      "claim": "Studies of restaurant workers generally do not find disemployment effects from minimum wage increases.",
      "source_url": "https://whatweknow.inequality.cornell.edu/topics/does-raising-the-minimum-wage-negatively-impact-employment",
      "confidence": "medium"
    },
    {
      "id": "F007",
      "claim": "There is no consensus in the literature on whether minimum wage increases negatively impact employment.",
      "source_url": "https://whatweknow.inequality.cornell.edu/topics/does-raising-the-minimum-wage-negatively-impact-employment",
      "confidence": "high"
    },
    {
      "id": "F008",
      "claim": "In a perfectly competitive labor market, workers are paid wages equal to their marginal revenue product.",
      "source_url": "https://courses.lumenlearning.com/suny-microeconomics/chapter/monopsony-and-the-minimum-wage",
      "confidence": "high"
    },
    {
      "id": "F009",
      "claim": "The imposition of a minimum wage above the equilibrium wage in a competitive labor market reduces employment.",
      "source_url": "https://courses.lumenlearning.com/suny-microeconomics/chapter/monopsony-and-the-minimum-wage",
      "confidence": "high"
    },
    {
      "id": "F010",
      "claim": "Minimum wage increases in a competitive labor market generate employment losses that lead to positive price passthrough.",
      "source_url": "https://cream-migration.org/publ_uploads/25036.pdf",
      "confidence": "medium"
    },
    {
      "id": "F011",
      "claim": "In a monopsony, employers pay workers less than their marginal revenue product.",
      "source_url": "https://courses.lumenlearning.com/suny-microeconomics/chapter/monopsony-and-the-minimum-wage",
      "confidence": "high"
    },
    {
      "id": "F012",
      "claim": "A minimum wage set above the equilibrium wage in a monopsony can increase both wages and employment.",
      "source_url": "https://courses.lumenlearning.com/suny-microeconomics/chapter/monopsony-and-the-minimum-wage",
      "confidence": "high"
    },
    {
      "id": "F013",
      "claim": "Increasing a minimum wage beyond a critical level in a monopsony produces negative employment effects.",
      "source_url": "https://www.youtube.com/watch?v=sHkF-9pJMLw",
      "confidence": "medium"
    },
    {
      "id": "F014",
      "claim": "Theoretical models suggest a non-monotone relationship between minimum wages and employment.",
      "source_url": "https://cream-migration.org/publ_uploads/25036.pdf",
      "confidence": "medium"
    },
    {
      "id": "F015",
      "claim": "Oligopsony models explain monopsony power through strategic interactions among a limited number of firms.",
      "source_url": "https://www.annualreviews.org/content/journals/10.1146/annurev-economics-072823-030431",
      "confidence": "high"
    },
    {
      "id": "F016",
      "claim": "Job differentiation models explain monopsony power through imperfect job substitution and heterogeneous worker preferences.",
      "source_url": "https://www.annualreviews.org/content/journals/10.1146/annurev-economics-072823-030431",
      "confidence": "high"
    },
    {
      "id": "F017",
      "claim": "Search-and-matching models explain monopsony power through search frictions that prevent instantaneous access to all available jobs.",
      "source_url": "https://www.annualreviews.org/content/journals/10.1146/annurev-economics-072823-030431",
      "confidence": "high"
    },
    {
      "id": "F018",
      "claim": "Empirical studies finding little to no negative employment effects from minimum wage increases are cited as evidence supporting the monopsony model.",
      "source_url": "https://www.youtube.com/watch?v=sHkF-9pJMLw",
      "confidence": "medium"
    },
    {
      "id": "F019",
      "claim": "Direct evidence for monopsony is measured by how firm-level labor supply reacts to exogenous wage changes.",
      "source_url": "https://www.nber.org/reporter/2024number1/monopsony-power-labor-markets",
      "confidence": "high"
    },
    {
      "id": "F020",
      "claim": "Some studies estimate employment elasticities without verifying that the policies studied changed wages.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F021",
      "claim": "The inclusion of workers not affected by minimum wage policies in elasticity estimates can lead to misleading results.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F022",
      "claim": "Research using geographically proximate controls often finds no employment effects from minimum wage increases.",
      "source_url": "https://wol.iza.org/articles/employment-effects-of-minimum-wages/long",
      "confidence": "high"
    },
    {
      "id": "F023",
      "claim": "Some studies are criticized for methodological problems that bias results toward finding job loss.",
      "source_url": "https://www.epi.org/publication/the-high-road-seattle-labor-market-and-the-effects-of-the-minimum-wage-increase-data-limitations-and-methodological-problems-bias-new-analysis-of-seattles-minimum-wage-incr",
      "confidence": "medium"
    },
    {
      "id": "F024",
      "claim": "Traditional panel data studies often find minimum wage employment elasticities of -0.1 to -0.3.",
      "source_url": "https://www.aeaweb.org/conference/2016/retrieve.php?pdfid=13434&tk=6kRDZNss",
      "confidence": "high"
    },
    {
      "id": "F025",
      "claim": "Factor model estimators designed to account for unobserved heterogeneity often find no employment effect from minimum wages.",
      "source_url": "https://www.aeaweb.org/conference/2016/retrieve.php?pdfid=13434&tk=6kRDZNss",
      "confidence": "high"
    },
    {
      "id": "F026",
      "claim": "Factor models may suffer from negative bias if minimum wage changes occur in locations with unusually low employment growth.",
      "source_url": "https://www.aeaweb.org/conference/2016/retrieve.php?pdfid=13434&tk=6kRDZNss",
      "confidence": "medium"
    },
    {
      "id": "F027",
      "claim": "There is a concern that publication bias leads to a preference for statistically significant findings.",
      "source_url": "https://econbrowser.com/archives/2015/03/23316",
      "confidence": "medium"
    },
    {
      "id": "F028",
      "claim": "The search for heterogeneous treatment effects in minimum wage research is prone to false discovery.",
      "source_url": "https://www.rfberlin.com/wp-content/uploads/2024/10/24025.pdf",
      "confidence": "medium"
    },
    {
      "id": "F029",
      "claim": "Studies measuring total hours instead of headcount employment produce conflicting results regarding minimum wage effects.",
      "source_url": "https://www.rfberlin.com/wp-content/uploads/2024/10/24025.pdf",
      "confidence": "high"
    },
    {
      "id": "F030",
      "claim": "The Congressional Budget Office has noted that scaling elasticities to the statutory minimum wage increase can yield misleading estimates.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F031",
      "claim": "Estimating employment effects for specific subgroups often suffers from a lack of statistical power.",
      "source_url": "https://www.rfberlin.com/wp-content/uploads/2024/10/24025.pdf",
      "confidence": "high"
    }
  ],
