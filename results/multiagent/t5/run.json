    {
      "id": "F001",
      "claim": "Bacteria in aquaculture environments develop resistance through spontaneous genetic mutations.",
      "source_url": "https://link.springer.com/article/10.1007/s44274-026-00773-6",
      "confidence": "high"
    },
    {
      "id": "F002",
      "claim": "Bacteria in aquaculture environments develop resistance by acquiring resistance genes from other microorganisms.",
