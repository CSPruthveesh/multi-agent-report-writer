      "confidence": "high"
    },
    {
      "id": "F003",
      "claim": "Horizontal gene transfer occurs through conjugation, which is the transfer of genetic material between bacteria.",
      "source_url": "https://www.mdpi.com/2304-8158/13/15/2448",
      "confidence": "high"
    },
    {
      "id": "F004",
      "claim": "Horizontal gene transfer occurs through transduction, which is the transfer of genes via bacteriophages.",
