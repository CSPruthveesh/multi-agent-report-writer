  "findings": [
    {
      "id": "F001",
      "claim": "Dube et al. (2024) and Cengiz et al. (2019) argue that employment shocks in the 1980s and 1990s bias estimates of minimum wage employment effects.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F002",
      "claim": "Dube et al. (2024) and Cengiz et al. (2019) contend that starting minimum wage employment analyses in the year 2000 avoids bias from pre-existing trends.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F003",
      "claim": "Dube, Lester, and Reich (2010) utilized contiguous county comparisons to control for regional economic influences and business cycles.",
      "source_url": "https://www.frbsf.org/research-and-insights/publications/economic-letter/2015/12/effects-of-minimum-wage-on-employment",
      "confidence": "high"
    },
    {
      "id": "F004",
      "claim": "Neumark and Wascher (2007) argue that meta-analyses should be sharply focused rather than simply averaging studies.",
      "source_url": "https://sites.socsci.uci.edu/~dneumark/MW%20US%20literature.05.pdf",
      "confidence": "high"
    },
    {
      "id": "F005",
      "claim": "Neumark argues that research designs that demand more of the data often result in larger standard errors.",
      "source_url": "https://sites.socsci.uci.edu/~dneumark/MW%20US%20literature.05.pdf",
      "confidence": "medium"
    },
    {
      "id": "F006",
      "claim": "Neumark and Wascher (2007) concluded that nearly two-thirds of newer studies found evidence of job loss.",
      "source_url": "https://www.frbsf.org/research-and-insights/publications/economic-letter/2015/12/effects-of-minimum-wage-on-employment",
      "confidence": "high"
    },
    {
      "id": "F007",
      "claim": "Neumark and Wascher (2007) concluded that 85% of studies they deemed most convincing found evidence of job loss.",
      "source_url": "https://www.frbsf.org/research-and-insights/publications/economic-letter/2015/12/effects-of-minimum-wage-on-employment",
      "confidence": "high"
    },
    {
      "id": "F008",
      "claim": "Neumark and Kala (2025) indicate that minimum wage job loss effects are more evident for Black men.",
      "source_url": "https://www.aeaweb.org/conference/2026/program/paper/erD6YH2h",
      "confidence": "high"
    },
    {
      "id": "F009",
      "claim": "Neumark and Kala (2025) do not find minimum wage job loss effects for Black females.",
      "source_url": "https://www.aeaweb.org/conference/2026/program/paper/erD6YH2h",
      "confidence": "high"
    },
    {
      "id": "F010",
      "claim": "Cengiz et al. (2019) found that minimum wage increases lead to a reduction in jobs paying below the new minimum.",
      "source_url": "https://assets.publishing.service.gov.uk/media/6960e4e656321405090869aa/impacts_of_minimum_wages_review_of_the_international_evidence_Arindrajit_Dube_web.pdf",
      "confidence": "high"
    },
    {
      "id": "F011",
      "claim": "Cengiz et al. (2019) found that job reductions below the new minimum wage are balanced by increases in jobs at higher wage levels.",
      "source_url": "https://assets.publishing.service.gov.uk/media/6960e4e656321405090869aa/impacts_of_minimum_wages_review_of_the_international_evidence_Arindrajit_Dube_web.pdf",
      "confidence": "high"
    },
    {
      "id": "F012",
      "claim": "Doucouliagos and Stanley (2009) investigated publication selection bias in minimum wage research.",
      "source_url": "https://www.frbsf.org/research-and-insights/publications/economic-letter/2015/12/effects-of-minimum-wage-on-employment",
      "confidence": "high"
    },
    {
      "id": "F013",
      "claim": "Traditional minimum wage studies use national-level panel data with state and period fixed effects.",
      "source_url": "https://onlabor.org/wp-content/uploads/2017/05/Spatial-Heterogeneity-and-Minimum-Wages.pdf",
      "confidence": "high"
    },
    {
      "id": "F014",
      "claim": "Traditional models often yield a negative employment elasticity of -0.165 for teenagers.",
      "source_url": "https://sites.socsci.uci.edu/~dneumark/Neumark%20et%20al%20MW%20evaluation%20May%202013%20ILRR%20final%20rev.pdf",
      "confidence": "high"
    },
    {
      "id": "F015",
      "claim": "Newer research methods include using census division-specific time effects to control for regional economic shocks.",
      "source_url": "https://onlabor.org/wp-content/uploads/2017/05/Spatial-Heterogeneity-and-Minimum-Wages.pdf",
      "confidence": "high"
    },
    {
      "id": "F016",
      "claim": "Newer research methods include comparing contiguous counties that straddle state borders.",
      "source_url": "https://escholarship.org/content/qt86w5m90m/qt86w5m90m_noSplash_477de9e826d71c581169a0c3c81f2040.pdf",
      "confidence": "high"
    },
    {
      "id": "F017",
      "claim": "Newer research methods include using commuting zones to define local labor markets.",
      "source_url": "https://escholarship.org/content/qt86w5m90m/qt86w5m90m_noSplash_477de9e826d71c581169a0c3c81f2040.pdf",
      "confidence": "high"
    },
    {
      "id": "F018",
      "claim": "Estimated employment effects often move toward zero or become positive when spatial heterogeneity controls are applied.",
      "source_url": "https://onlabor.org/wp-content/uploads/2017/05/Spatial-Heterogeneity-and-Minimum-Wages.pdf",
      "confidence": "medium"
    },
    {
      "id": "F019",
      "claim": "A 1982 review by Brown et al. established a consensus range for the elasticity of teenage employment with respect to the minimum wage of -0.1 to -0.3.",
      "source_url": "https://www.nber.org/system/files/working_papers/w12663/w12663.pdf",
      "confidence": "high"
    },
    {
      "id": "F020",
      "claim": "Sabia, Burkhauser, and Hansen (2012) found a median elasticity of approximately -0.7 in New York.",
      "source_url": "https://issuelab.org/resources/14701/14701.pdf",
      "confidence": "high"
    },
    {
      "id": "F021",
      "claim": "Some studies report an elasticity of -4.6 for men aged 25\u201329 caught by the minimum wage.",
      "source_url": "https://www.nber.org/system/files/working_papers/w12663/w12663.pdf",
      "confidence": "high"
    },
    {
      "id": "F022",
      "claim": "A survey of U.S. economists found that 74% oppose a $15 federal minimum wage.",
      "source_url": "https://epionline.org/studies/survey-of-us-economists-on-a-15-federal-minimum-wage-2",
      "confidence": "high"
    },
    {
      "id": "F023",
      "claim": "A survey of U.S. economists found that 84% believe a $15 federal minimum wage would have negative effects on youth employment.",
      "source_url": "https://epionline.org/studies/survey-of-us-economists-on-a-15-federal-minimum-wage-2",
      "confidence": "high"
    },
    {
      "id": "F024",
      "claim": "Researchers sometimes conflate the employment elasticity with respect to the minimum wage with the own-wage elasticity.",
      "source_url": "https://www.rfberlin.com/wp-content/uploads/2024/10/24025.pdf",
      "confidence": "medium"
    },
    {
      "id": "F025",
      "claim": "Focusing on teenagers for minimum wage studies reduces external validity.",
      "source_url": "https://www.rfberlin.com/wp-content/uploads/2024/10/24025.pdf",
      "confidence": "low"
    },
    {
      "id": "F026",
      "claim": "Firms may respond to wage floors through automation, price increases, or other operational changes.",
      "source_url": "https://issuelab.org/resources/14701/14701.pdf",
      "confidence": "medium"
    },
    {
      "id": "F027",
      "claim": "Some researchers argue that the size and frequency of wage jumps influence whether employment reductions are observed.",
      "source_url": "https://aier.org/article/the-economics-of-the-minimum-wage-myths-facts-and-consequences",
      "confidence": "medium"
    },
    {
      "id": "F028",
      "claim": "Minimum wage effect findings vary based on the analysis sample and the magnitude of the minimum wage changes considered.",
      "source_url": "https://www.nber.org/system/files/working_papers/w30668/w30668.pdf",
      "confidence": "high"
    },
    {
      "id": "F029",
      "claim": "Commuting spillovers suggest larger minimum wage effects in narrow bands near state borders.",
      "source_url": "https://jorgeperezperez.com/files/Jorge_Perez_JMP.pdf",
      "confidence": "medium"
    },
    {
      "id": "F030",
      "claim": "Dube et al. (2010) did not find significant county spillover effects using their methods.",
      "source_url": "https://jorgeperezperez.com/files/Jorge_Perez_JMP.pdf",
      "confidence": "high"
    },
    {
      "id": "F031",
      "claim": "Spatial equilibrium models suggest that commuting and migration responses to relative minimum wage changes are significant.",
      "source_url": "https://sciencespo.hal.science/hal-03459328/file/2016-monras-minimum-wage-and-space.pdf",
      "confidence": "high"
    },
    {
      "id": "F032",
      "claim": "State-level panel regressions report employment effect coefficients for teens and all workers with p-values ranging from .343 to .758.",
      "source_url": "https://irle.berkeley.edu/wp-content/uploads/2019/07/Minimum-Wage-Effects-in-Low-Wage-Areas.pdf",
      "confidence": "high"
    },
    {
      "id": "F033",
      "claim": "Models incorporating spatial equilibrium factors report implied local labor demand elasticities ranging from -1.138 to -1.471.",
      "source_url": "https://crei.cat/wp-content/uploads/2020/06/11-minimum-w-1.pdf",
      "confidence": "high"
    },
    {
      "id": "F034",
      "claim": "Standard state-level panel regressions yield a teen employment elasticity of -0.3 when state-specific year trends are excluded.",
      "source_url": "https://sciencespo.hal.science/hal-03459328/file/2016-monras-minimum-wage-and-space.pdf",
      "confidence": "high"
    },
    {
      "id": "F035",
      "claim": "Standard state-level panel regressions yield an employment elasticity of 0 for older low-skilled workers when state-specific year trends are excluded.",
      "source_url": "https://sciencespo.hal.science/hal-03459328/file/2016-monras-minimum-wage-and-space.pdf",
      "confidence": "high"
    },
    {
      "id": "F036",
      "claim": "Joan Monras's spatial equilibrium model reports implied local labor demand elasticities ranging from -1.138 to -1.471 in one model version.",
      "source_url": "https://sciencespo.hal.science/hal-03459328/file/2016-monras-minimum-wage-and-space.pdf",
      "confidence": "high"
    },
    {
      "id": "F037",
      "claim": "Joan Monras's spatial equilibrium model reports implied local labor demand elasticities ranging from 2.582 to 2.873 in an alternative model version.",
      "source_url": "https://sciencespo.hal.science/hal-03459328/file/2016-monras-minimum-wage-and-space.pdf",
      "confidence": "high"
    },
    {
      "id": "F038",
      "claim": "The employment elasticity for male teens is -0.398 in heavily black areas.",
      "source_url": "https://www.aeaweb.org/conference/2026/program/paper/erD6YH2h",
      "confidence": "high"
    },
    {
      "id": "F039",
      "claim": "The employment elasticity for male teens is -0.116 in white areas.",
      "source_url": "https://www.aeaweb.org/conference/2026/program/paper/erD6YH2h",
      "confidence": "high"
    },
    {
      "id": "F040",
      "claim": "A 10% minimum wage increase is associated with a 0.3% to 1.1% increase in prices.",
      "source_url": "https://jorgeperezperez.com/sitemap",
      "confidence": "medium"
    },
    {
      "id": "F041",
      "claim": "There is no observable difference in employment effects between federal and state-level minimum wage increases in the spatial equilibrium framework.",
