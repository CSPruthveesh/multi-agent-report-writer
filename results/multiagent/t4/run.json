  "findings": [
    {
      "id": "F001",
      "claim": "Dube et al. (2024) argue that analyses including data from the 1980s and 1990s are biased due to employment shocks that predated minimum wage increases.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F002",
      "claim": "Dube et al. (2024) contend that starting analyses in 2000 avoids bias from employment shocks that predated minimum wage increases.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F003",
      "claim": "Neumark and Wascher (2007) argue that studies focusing on specific, low-skill groups provide more convincing evidence of job loss.",
      "source_url": "https://www.frbsf.org/research-and-insights/publications/economic-letter/2015/12/effects-of-minimum-wage-on-employment",
      "confidence": "high"
    },
    {
      "id": "F004",
      "claim": "Dube, Lester, and Reich (2010) utilize contiguous county comparisons to isolate minimum wage effects from broader business cycle influences.",
      "source_url": "https://www.frbsf.org/research-and-insights/publications/economic-letter/2015/12/effects-of-minimum-wage-on-employment",
      "confidence": "high"
    },
    {
      "id": "F005",
      "claim": "Neumark and Wascher (2007) concluded that 85% of studies they deemed most convincing found evidence of job loss.",
      "source_url": "https://www.frbsf.org/research-and-insights/publications/economic-letter/2015/12/effects-of-minimum-wage-on-employment",
      "confidence": "high"
    },
    {
      "id": "F006",
      "claim": "Neumark and Kala (2025) find that job loss effects from minimum wage increases are more evident for Black workers.",
      "source_url": "https://www.aeaweb.org/conference/2026/program/paper/erD6YH2h",
      "confidence": "high"
    },
    {
      "id": "F007",
      "claim": "Neumark and Kala (2025) find that minimum wage increases may reduce the total earnings of low-skilled Black workers.",
      "source_url": "https://www.aeaweb.org/conference/2026/program/paper/erD6YH2h",
      "confidence": "high"
    },
    {
      "id": "F008",
      "claim": "Card and Krueger (1995) examined publication selection bias regarding minimum wage research.",
      "source_url": "https://eml.berkeley.edu/~card/papers/time%20minwage.pdf",
      "confidence": "high"
    },
    {
      "id": "F009",
      "claim": "Traditional approaches using state-level controls often fail to account for spatial heterogeneity.",
      "source_url": "https://irle.berkeley.edu/publications/working-papers/spatial-heterogeneity-and-minimum-wages-employment-estimates-for-teens-using-cross-state-commuting-zones",
      "confidence": "high"
    },
    {
      "id": "F010",
      "claim": "Allegretto, Dube, and Reich use census division-specific time effects to control for regional economic trends.",
      "source_url": "https://irle.berkeley.edu/publications/working-papers/spatial-heterogeneity-and-minimum-wages-employment-estimates-for-teens-using-cross-state-commuting-zones",
      "confidence": "high"
    },
    {
      "id": "F011",
      "claim": "Border-county designs compare counties in close geographic proximity that share a border but have different minimum wage policies.",
      "source_url": "https://irle.berkeley.edu/publications/working-papers/spatial-heterogeneity-and-minimum-wages-employment-estimates-for-teens-using-cross-state-commuting-zones",
      "confidence": "high"
    },
    {
      "id": "F012",
      "claim": "Border-county designs exploit state-level wage differences across borders to construct counterfactuals.",
      "source_url": "https://www.sciencedirect.com/science/article/pii/S1757780223001129",
      "confidence": "high"
    },
    {
      "id": "F013",
      "claim": "Adding excessive region-specific fixed effects, trends, and controls can absorb useful variation in the data.",
      "source_url": "https://grcmlesydpcd.objectstorage.sa-saopaulo-1.oci.customer-oci.com/p/OQwcvnO-c63O08Gc2Kv4OTbJttj5ik60dguiDIyyQ0wuo5SWn-jHOLW9wNbylNqI/n/grcmlesydpcd/b/dtysppobjmntbkp01/o/media/doity/submissoes/artigo-0213c039f46dfcd1a1633304270fab14dded3677-arquivo.pdf",
      "confidence": "medium"
    },
    {
      "id": "F014",
      "claim": "Some models use dummy variables to test whether federal minimum wage changes produce different employment effects than state-level changes.",
      "source_url": "https://crei.cat/wp-content/uploads/2020/06/11-minimum-w-1.pdf",
      "confidence": "medium"
    },
    {
      "id": "F015",
      "claim": "The fraction affected design relies on the heterogeneity in the bindingness of minimum wages across different states to identify employment effects.",
      "source_url": "https://grcmlesydpcd.objectstorage.sa-saopaulo-1.oci.customer-oci.com/p/OQwcvnO-c63O08Gc2Kv4OTbJttj5ik60dguiDIyyQ0wuo5SWn-jHOLW9wNbylNqI/n/grcmlesydpcd/b/dtysppobjmntbkp01/o/media/doity/submissoes/artigo-0213c039f46dfcd1a1633304270fab14dded3677-arquivo.pdf",
      "confidence": "medium"
    },
    {
      "id": "F016",
      "claim": "The use of instrumental variables is a method cited to mitigate biases in estimating the effects of minimum wages.",
      "source_url": "https://grcmlesydpcd.objectstorage.sa-saopaulo-1.oci.customer-oci.com/p/OQwcvnO-c63O08Gc2Kv4OTbJttj5ik60dguiDIyyQ0wuo5SWn-jHOLW9wNbylNqI/n/grcmlesydpcd/b/dtysppobjmntbkp01/o/media/doity/submissoes/artigo-0213c039f46dfcd1a1633304270fab14dded3677-arquivo.pdf",
      "confidence": "medium"
    },
    {
      "id": "F017",
      "claim": "Research increasingly utilizes county-level data and county-pair designs to capture local labor market dynamics.",
      "source_url": "https://www.sciencedirect.com/science/article/pii/S1757780223001129",
      "confidence": "high"
    },
    {
      "id": "F018",
      "claim": "Prior to the late 1980s, economists reached a consensus that the elasticity of teenage employment with respect to the minimum wage was between -0.1 and -0.3.",
      "source_url": "https://www.nber.org/system/files/working_papers/w12663/w12663.pdf",
      "confidence": "high"
    },
    {
      "id": "F019",
      "claim": "The 1982 Minimum Wage Study Commission concluded that a 10% increase in the minimum wage typically reduced teenage employment by 1% to 3%.",
      "source_url": "https://www.nber.org/system/files/working_papers/w12663/w12663.pdf",
      "confidence": "high"
    },
    {
      "id": "F020",
      "claim": "Modern research lacks a consensus regarding the overall effects of minimum wage increases on low-wage employment.",
      "source_url": "https://www.nber.org/system/files/working_papers/w12663/w12663.pdf",
      "confidence": "high"
    },
    {
      "id": "F021",
      "claim": "Some recent meta-studies report little or no negative employment outcomes from minimum wage increases.",
      "source_url": "https://cepr.net/documents/publications/min-wage-2013-02.pdf",
      "confidence": "medium"
    },
    {
      "id": "F022",
      "claim": "Some research supports the view that minimum wage increases reduce employment for low-skilled workers.",
      "source_url": "https://aier.org/article/the-economics-of-the-minimum-wage-myths-facts-and-consequences",
      "confidence": "medium"
    },
    {
      "id": "F023",
      "claim": "A 2019 survey of 197 U.S. economists regarding a $15 federal minimum wage had a 22% response rate.",
      "source_url": "https://epionline.org/studies/survey-of-us-economists-on-a-15-federal-minimum-wage-2",
      "confidence": "high"
    },
    {
      "id": "F024",
      "claim": "Critics of studies showing no employment loss argue that such results require implausibly low elasticity of demand from customers.",
      "source_url": "https://econbrowser.com/archives/2015/03/23316",
      "confidence": "medium"
    },
    {
      "id": "F025",
      "claim": "Critics of studies showing no employment loss argue that such results require limited ability for firms to substitute away from low-skill labor.",
      "source_url": "https://econbrowser.com/archives/2015/03/23316",
      "confidence": "medium"
    },
    {
      "id": "F026",
      "claim": "Some critics argue that certain time-series studies produce non-zero estimates due to the regression of unrelated random walks with drift.",
      "source_url": "https://econbrowser.com/archives/2015/03/23316",
      "confidence": "medium"
    },
    {
      "id": "F027",
      "claim": "Some researchers argue that employers may respond to wage floors through price increases, automation, or reduced passthrough rather than employment adjustments.",
      "source_url": "https://aier.org/article/the-economics-of-the-minimum-wage-myths-facts-and-consequences",
      "confidence": "medium"
    },
    {
      "id": "F028",
      "claim": "Dube, Lester, and Reich (2010) estimated an employment elasticity of 0.217 using a traditional specification with county and time fixed effects.",
      "source_url": "https://escholarship.org/content/qt86w5m90m/qt86w5m90m_noSplash_477de9e826d71c581169a0c3c81f2040.pdf",
      "confidence": "high"
    },
    {
      "id": "F029",
      "claim": "Dube, Lester, and Reich (2010) estimated an employment elasticity of 0.188 using a local specification comparing contiguous border counties.",
      "source_url": "https://escholarship.org/content/qt86w5m90m/qt86w5m90m_noSplash_477de9e826d71c581169a0c3c81f2040.pdf",
      "confidence": "high"
    },
    {
      "id": "F030",
      "claim": "Neumark et al. report a four-year cumulative employment elasticity of -0.593 using a county-level sample.",
      "source_url": "https://docs.iza.org/dp15282.pdf",
      "confidence": "high"
    },
    {
      "id": "F031",
      "claim": "Neumark et al. report a four-year cumulative employment elasticity of -0.559 using a commuting zone-state sample.",
      "source_url": "https://docs.iza.org/dp15282.pdf",
      "confidence": "high"
    },
    {
      "id": "F032",
      "claim": "Analyses using multi-state commuting zones have produced a four-year cumulative employment elasticity of -0.689.",
      "source_url": "https://docs.iza.org/dp15282.pdf",
      "confidence": "high"
    },
    {
      "id": "F033",
      "claim": "Cross-border design estimates are often less precise than other methods.",
      "source_url": "https://www.aeaweb.org/conference/2026/program/paper/erD6YH2h",
      "confidence": "low"
    },
    {
      "id": "F034",
      "claim": "The border-county design incorporates county-pair-by-time fixed effects into the two-way fixed effects framework.",
      "source_url": "https://jorgeperezperez.com/files/PerezMinimumWagePricesMetaanalysis.pdf",
      "confidence": "medium"
    },
    {
      "id": "F035",
      "claim": "Minimum wage increases lower the employment rate in heavily Black areas by 3.5 percentage points relative to white areas.",
      "source_url": "https://www.nber.org/system/files/working_papers/w33167/w33167.pdf",
      "confidence": "high"
    },
    {
      "id": "F036",
      "claim": "The model used by Neumark and Kala includes an interaction term between the natural log of the minimum wage and an indicator for Black PUMA cell means.",
      "source_url": "https://www.nber.org/system/files/working_papers/w33167/w33167.pdf",
      "confidence": "high"
    },
    {
      "id": "F037",
      "claim": "The Black minimum wage-employment elasticity ranges between -0.286 and -0.401.",
      "source_url": "https://www.hoover.org/sites/default/files/2024-12/Neumark%20Seminar%20Hoover.pdf",
      "confidence": "high"
    },
    {
      "id": "F038",
      "claim": "The white minimum wage-employment elasticity ranges between -0.008 and -0.095.",
      "source_url": "https://www.hoover.org/sites/default/files/2024-12/Neumark%20Seminar%20Hoover.pdf",
      "confidence": "high"
    },
    {
      "id": "F039",
      "claim": "Job loss effects from higher minimum wages are more evident for Black men than for other demographic groups.",
      "source_url": "https://www.nber.org/system/files/working_papers/w33167/w33167.pdf",
      "confidence": "medium"
    },
    {
      "id": "F040",
      "claim": "Minimum wage-related job loss effects extend beyond the teenage demographic to include broader low-skill groups.",
      "source_url": "https://www.nber.org/system/files/working_papers/w33167/w33167.pdf",
      "confidence": "medium"
    }
  ],
