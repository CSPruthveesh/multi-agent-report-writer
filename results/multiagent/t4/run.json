    },
    {
      "id": "F032",
      "claim": "The UK Low Pay Commission found that employment performance for women, older workers, disabled workers, ethnic minorities, and migrants has been better since 2008 than for groups not affected by the National Minimum Wage.",
      "source_url": "https://www.nerinstitute.net/blog/fact-gathering-minimum-wage-what-do-meta-studies-show",
