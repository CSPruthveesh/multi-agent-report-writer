    {
      "id": "F001",
      "claim": "Allegretto, Dube, and Reich argue that traditional difference-in-difference models for estimating minimum wage employment effects are flawed.",
      "source_url": "https://irle.berkeley.edu/wp-content/uploads/2019/03/The-Employment-Effects-of-a-15-Minimum-Wage-in-the-US-and-in-Mississippi.pdf",
      "confidence": "high"
    },
    {
      "id": "F002",
      "claim": "Allegretto, Dube, and Reich argue that U.S. minimum wage research should restrict comparison areas to those that are geographically proximate.",
      "source_url": "https://whatweknow.inequality.cornell.edu/topics/does-raising-the-minimum-wage-negatively-impact-employment",
      "confidence": "high"
    },
    {
      "id": "F003",
      "claim": "Allegretto, Dube, and Reich argue that standard minimum wage employment estimates are biased by the inclusion of the early 1990s period in estimation samples.",
