      "confidence": "high"
    },
    {
      "id": "F004",
      "claim": "Allegretto, Dube, and Reich (2011) reported an own-wage elasticity estimate of 0.315 with a standard error of 0.402 for teens.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F005",
      "claim": "Allegretto, Dube, Reich, and Zipperer (2017) reported an own-wage elasticity estimate of 0.043 with a standard error of 0.188 for teens.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F006",
      "claim": "Dube, Lester, and Reich (2016) found that a 10% increase in the minimum wage results in a 2.1% reduction in turnover for restaurant workers and teens.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F007",
      "claim": "Dube, Lester, and Reich (2016) reported an own-wage elasticity estimate of -0.266 with a standard error of 0.383 for teens.",
      "source_url": "https://www.nber.org/system/files/working_papers/w32925/w32925.pdf",
      "confidence": "high"
    },
    {
      "id": "F008",
      "claim": "In a perfectly competitive labor market, firms are wage-takers.",
      "source_url": "https://courses.lumenlearning.com/suny-microeconomics/chapter/monopsony-and-the-minimum-wage",
      "confidence": "high"
    },
    {
      "id": "F009",
      "claim": "In a perfectly competitive labor market, workers are paid their marginal revenue product.",
      "source_url": "https://www.pearson.com/channels/microeconomics/learn/brian/ch-15-markets-for-the-factors-of-production/monopsony",
      "confidence": "high"
    },
    {
      "id": "F010",
      "claim": "The competitive labor market model predicts that a minimum wage above the equilibrium wage reduces employment.",
      "source_url": "https://courses.lumenlearning.com/suny-microeconomics/chapter/monopsony-and-the-minimum-wage",
      "confidence": "high"
    },
    {
      "id": "F011",
      "claim": "The competitive labor market model predicts that a minimum wage above the equilibrium wage increases unemployment.",
      "source_url": "https://maxkasy.github.io/home/files/teaching/Labor_Oxford_2021/4-Labor-Demand.pdf",
      "confidence": "high"
    },
    {
      "id": "F012",
      "claim": "The competitive labor market model predicts that minimum wage increases result in positive price passthrough.",
      "source_url": "https://cream-migration.org/publ_uploads/25036.pdf",
      "confidence": "medium"
    },
    {
      "id": "F013",
      "claim": "In a monopsony labor market, employers pay workers less than their marginal revenue product.",
      "source_url": "https://www.annualreviews.org/content/journals/10.1146/annurev-economics-072823-030431",
      "confidence": "high"
    },
    {
      "id": "F014",
      "claim": "In a monopsony labor market, the marginal cost of labor exceeds the wage because firms must increase wages for all existing employees to hire an additional worker.",
      "source_url": "https://www.pearson.com/channels/microeconomics/learn/brian/ch-15-markets-for-the-factors-of-production/monopsony",
      "confidence": "high"
    },
    {
      "id": "F015",
      "claim": "The monopsony model predicts that a minimum wage set above the equilibrium wage can increase both wages and employment simultaneously.",
      "source_url": "https://courses.lumenlearning.com/suny-microeconomics/chapter/monopsony-and-the-minimum-wage",
      "confidence": "high"
    },
    {
      "id": "F016",
      "claim": "The relationship between minimum wages and employment in the monopsony model is non-monotonic.",
      "source_url": "https://cream-migration.org/publ_uploads/25036.pdf",
      "confidence": "medium"
    },
    {
      "id": "F017",
      "claim": "The monopsony model can yield negative price passthrough.",
      "source_url": "https://cream-migration.org/publ_uploads/25036.pdf",
      "confidence": "medium"
    },
    {
      "id": "F018",
      "claim": "Oligopsony is a theoretical framework for monopsony power involving strategic interactions among a limited number of firms.",
      "source_url": "https://www.annualreviews.org/content/journals/10.1146/annurev-economics-072823-030431",
      "confidence": "high"
    },
    {
      "id": "F019",
      "claim": "Job differentiation is a theoretical framework for monopsony power involving imperfect job substitution and heterogeneous worker preferences.",
      "source_url": "https://www.annualreviews.org/content/journals/10.1146/annurev-economics-072823-030431",
      "confidence": "high"
    },
    {
      "id": "F020",
      "claim": "Search-and-matching is a theoretical framework for monopsony power involving frictions that prevent instantaneous access to all available jobs.",
      "source_url": "https://www.annualreviews.org/content/journals/10.1146/annurev-economics-072823-030431",
      "confidence": "high"
    },
    {
      "id": "F021",
      "claim": "An employer has monopsony power if their labor supply is not infinitely elastic.",
